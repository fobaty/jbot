+ * out command cannot be reapplied between slow ticks. rate / 5 preserves the
+ * commanded slew per second of the original 5 ms rate limiter.
+ */
+static void fastCommandStep(void) {
+  fastSerialInput();                    // atomic command snapshot, scaling and timeout mirror
+
+  rateLimiter16(input1[inIdx].cmd, (int16_t)(rate / 5), &steerRateFixdt);
+  rateLimiter16(input2[inIdx].cmd, (int16_t)(rate / 5), &speedRateFixdt);
+  filtLowPass32(steerRateFixdt >> 4, filtCoef, &steerFixdt);
+  filtLowPass32(speedRateFixdt >> 4, filtCoef, &speedFixdt);
+  steer = (int16_t)(steerFixdt >> 16);
+  speed = (int16_t)(speedFixdt >> 16);
+  mixerFcn(speed << 4, steer << 4, &cmdR, &cmdL);
+
+  #ifdef INVERT_R_DIRECTION
+    pwmr = cmdR;
+  #else
+    pwmr = -cmdR;
+  #endif
+  #ifdef INVERT_L_DIRECTION
+    pwml = -cmdL;
+  #else
+    pwml = cmdL;
+  #endif
