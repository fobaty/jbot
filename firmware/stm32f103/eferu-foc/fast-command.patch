+/*
+ * Refresh the USART2 commands at the 1 kHz tick. Timeout qualification stays in
+ * handleTimeout() at the 5 ms tick, so only its zeroing is mirrored here.
+ */
+void fastSerialInput(void) {
+  SerialCommand cmd;
+
+  __disable_irq();                      // both int16 fields come from the Rx ISR as one snapshot
+  cmd = commandL;
+  __enable_irq();
+
+  input1[inIdx].raw = cmd.steer;
+  input2[inIdx].raw = cmd.speed;
+  calcInputCmd(&input1[inIdx], INPUT_MIN, INPUT_MAX);
+  calcInputCmd(&input2[inIdx], INPUT_MIN, INPUT_MAX);
+
+  if (timeoutFlgADC || timeoutFlgSerial || timeoutFlgGen) {
+    input1[inIdx].cmd = 0;
+    input2[inIdx].cmd = 0;
+  }
+}
