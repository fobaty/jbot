--- a/Inc/config.h
+++ b/Inc/config.h
@@ -155,13 +155,16 @@
 
 // Control selections
 #define CTRL_TYP_SEL    FOC_CTRL        // [-] Control type selection: COM_CTRL, SIN_CTRL, FOC_CTRL (default)
-#define CTRL_MOD_REQ    VLT_MODE        // [-] Control mode request: OPEN_MODE, VLT_MODE (default), SPD_MODE, TRQ_MODE. Note: SPD_MODE and TRQ_MODE are only available for CTRL_FOC!
+#define CTRL_MOD_REQ    TRQ_MODE        // [-] Control mode request: OPEN_MODE, VLT_MODE (default), SPD_MODE, TRQ_MODE. Note: SPD_MODE and TRQ_MODE are only available for CTRL_FOC!
+#define ANGLE_MEAS_ENA  0               // [-] 0 = hall-speed-integrated electrical angle, 1 = measured hall angle. Runtime-settable as ANG_MEAS over the debug UART.
 #define DIAG_ENA        1               // [-] Motor Diagnostics enable flag: 0 = Disabled, 1 = Enabled (default)
 
 // Limitation settings
-#define I_MOT_MAX       15              // [A] Maximum single motor current limit
-#define I_DC_MAX        17              // [A] Maximum stage2 DC Link current limit for Commutation and Sinusoidal types (This is the final current protection. Above this value, current chopping is applied. To avoid this make sure that I_DC_MAX = I_MOT_MAX + 2A)
-#define N_MOT_MAX       1000            // [rpm] Maximum motor speed limit
+// JBOT bench profile: conservative limits for the original 10s2p 4.4 Ah pack.
+// Raise I_MOT_MAX towards 15 A only after measuring MOSFET and pack temperature.
+#define I_MOT_MAX       10              // [A] Maximum single motor current limit
+#define I_DC_MAX        12              // [A] Maximum stage2 DC Link current limit for Commutation and Sinusoidal types (This is the final current protection. Above this value, current chopping is applied. To avoid this make sure that I_DC_MAX = I_MOT_MAX + 2A)
+#define N_MOT_MAX       400             // [rpm] Maximum motor speed limit
 
 // Field Weakening / Phase Advance
 #define FIELD_WEAK_ENA  0               // [-] Field Weakening / Phase Advance enable flag: 0 = Disabled (default), 1 = Enabled
@@ -347,6 +350,16 @@
   // #define TANK_STEERING              // use for tank steering, each input controls each wheel 
   // #define SUPPORT_BUTTONS_LEFT       // use left sensor board cable for button inputs.  Disable DEBUG_SERIAL_USART2!
   // #define SUPPORT_BUTTONS_RIGHT      // use right sensor board cable for button inputs. Disable DEBUG_SERIAL_USART3!
+
+  // Faster input response for the balance link. The default 0.1 (tau ~47 ms)
+  // dominates the measured 190-230 ms command-to-wheel dead time; 0.3 gives
+  // tau ~14 ms while keeping the current loop damped.
+  #define FILTER 19661
+
+  // Bench debug serial on USART3 (right cable). USART2 carries the control
+  // link and feedback, so debug must not share it. The Pico bridges GP12/GP13
+  // to this port and forwards the text to its USB console.
+  #define DEBUG_SERIAL_USART3
 #endif
 // ######################## END OF VARIANT_USART SETTINGS #########################
 
@@ -448,6 +461,10 @@
     #define PRI_INPUT2            3, -1000, 0, 1000, 100  // TYPE, MIN, MID, MAX, DEADBAND. See INPUT FORMAT section
   #endif
 
+  // JBOT bench profile: debug output on the LEFT cable (USART2, PA2/PA3).
+  // The right cable is occupied by the PWM input, so USART3 debug is not available.
+  #define DEBUG_SERIAL_USART2
+
   #define FILTER                  6553    // 0.1f [-] fixdt(0,16,16) lower value == softer filter [0, 65535] = [0.0 - 1.0].
   #define SPEED_COEFFICIENT       16384   // 1.0f [-] fixdt(1,16,14) higher value == stronger. [0, 65535] = [-2.0 - 2.0]. In this case 16384 = 1.0 * 2^14
   #define STEER_COEFFICIENT       16384   // 1.0f [-] fixdt(1,16,14) higher value == stronger. [0, 65535] = [-2.0 - 2.0]. In this case 16384 = 1.0 * 2^14. If you do not want any steering, set it to 0.
